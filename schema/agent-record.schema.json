{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LNLugo/agent-registry-reference/schema/agent-record.schema.json",
  "title": "Agent registry record",
  "description": "One record per AI agent. The registry is the system of record for identity, ownership, risk and review status. Cost and environment tags are carried as a mapping to the cloud tag taxonomy, not as the source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "name",
    "purpose",
    "platform",
    "environment",
    "status",
    "business_owner",
    "technical_owner",
    "accountable_executive",
    "risk_tier",
    "autonomy_level",
    "data_classification",
    "models",
    "tools",
    "identity",
    "evaluation",
    "review",
    "cost_tags",
    "platform_ref"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^agt-[a-z0-9-]{3,48}$",
      "description": "Stable registry ID. Propagated as the x-agent-id header at the gateway and as gen_ai.agent.id on every span."
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "description": "Business purpose in one or two sentences. Reviewed at every re-attestation."
    },
    "platform": {
      "enum": [
        "aws-agentcore",
        "copilot-studio",
        "agentforce",
        "vendor-saas",
        "in-house"
      ]
    },
    "vendor": {
      "type": "string",
      "description": "Required when platform is agentforce or vendor-saas."
    },
    "environment": {
      "enum": [
        "development",
        "test",
        "production"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "suspended",
        "retired"
      ]
    },
    "business_owner": {
      "$ref": "#/$defs/person"
    },
    "technical_owner": {
      "$ref": "#/$defs/person"
    },
    "accountable_executive": {
      "$ref": "#/$defs/person"
    },
    "risk_tier": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "autonomy_level": {
      "enum": [
        "assist",
        "act_with_approval",
        "act"
      ],
      "description": "assist: drafts or answers only. act_with_approval: takes actions after a human approves. act: takes actions without per action approval."
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "version"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "prompt_version": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "access"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "access": {
            "enum": [
              "read",
              "write"
            ]
          },
          "mcp_server": {
            "type": "string"
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "principal"
      ],
      "properties": {
        "type": {
          "enum": [
            "service_identity",
            "maker_connection"
          ],
          "description": "maker_connection means the agent runs on a person's credentials. Allowed only below production."
        },
        "principal": {
          "type": "string"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_run",
        "result"
      ],
      "properties": {
        "last_run": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "suite": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_review",
        "next_review"
      ],
      "properties": {
        "last_review": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "next_review": {
          "type": "string",
          "format": "date"
        },
        "governance_forum": {
          "type": "string",
          "description": "Where high risk agents are reviewed, for example an AI governance committee."
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason",
          "remediation",
          "expires",
          "approved_by"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "expires": {
            "type": "string",
            "format": "date"
          },
          "approved_by": {
            "type": "string"
          }
        }
      }
    },
    "cost_tags": {
      "type": "object",
      "description": "Mapping to the cloud tag taxonomy used for ownership and cost attribution.",
      "additionalProperties": false,
      "required": [
        "Application",
        "ApplicationOwner",
        "Environment",
        "CostCenter"
      ],
      "properties": {
        "Application": {
          "type": "string"
        },
        "ApplicationOwner": {
          "type": "string"
        },
        "Environment": {
          "type": "string"
        },
        "CostCenter": {
          "type": "string"
        },
        "Model": {
          "type": "string"
        },
        "Project": {
          "type": "string"
        },
        "ClientEngagement": {
          "type": "string"
        }
      }
    },
    "registered_on": {
      "type": "string",
      "format": "date"
    },
    "platform_ref": {
      "type": "string",
      "description": "The platform's own identifier for the agent (AgentCore runtime ARN, Copilot Studio bot ID, Agentforce API name). Used to reconcile discovered agents against the registry."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "platform": {
            "enum": [
              "agentforce",
              "vendor-saas"
            ]
          }
        }
      },
      "then": {
        "required": [
          "vendor"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "risk_tier": {
            "const": "high"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "required": [
              "governance_forum"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "email"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        }
      }
    }
  }
}