{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LNLugo/agent-registry-reference/schema/agent-record.schema.json",
  "title": "Agent registry record",
  "description": "One record per AI agent. The registry is the system of record for identity, ownership, risk and review status. Cost and environment tags are carried as a mapping to the cloud tag taxonomy, not as the source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "name",
    "purpose",
    "platform",
    "environment",
    "status",
    "business_owner",
    "technical_owner",
    "accountable_executive",
    "risk_tier",
    "autonomy_level",
    "data_classification",
    "models",
    "tools",
    "identity",
    "evaluation",
    "review",
    "cost_tags",
    "platform_ref"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^agt-[a-z0-9-]{3,48}$",
      "description": "Stable registry ID. Propagated as the x-agent-id header at the gateway and as gen_ai.agent.id on every span."
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "description": "Business purpose in one or two sentences. Reviewed at every re-attestation."
    },
    "platform": {
      "enum": [
        "aws-agentcore",
        "copilot-studio",
        "agentforce",
        "vendor-saas",
        "in-house"
      ]
    },
    "vendor": {
      "type": "string",
      "description": "Required when platform is agentforce or vendor-saas."
    },
    "environment": {
      "enum": [
        "development",
        "test",
        "production"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "suspended",
        "retired"
      ]
    },
    "business_owner": {
      "$ref": "#/$defs/person"
    },
    "technical_owner": {
      "$ref": "#/$defs/person"
    },
    "accountable_executive": {
      "$ref": "#/$defs/person"
    },
    "risk_tier": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "autonomy_level": {
      "enum": [
        "assist",
        "act_with_approval",
        "act"
      ],
      "description": "assist: drafts or answers only. act_with_approval: takes actions after a human approves. act: takes actions without per action approval."
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "version"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "prompt_version": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "access"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "access": {
            "enum": [
              "read",
              "write"
            ]
          },
          "mcp_server": {
            "type": "string"
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "principal"
      ],
      "properties": {
        "type": {
          "enum": [
            "service_identity",
            "maker_connection"
          ],
          "description": "maker_connection means the agent runs on a person's credentials. Allowed only below production."
        },
        "principal": {
          "type": "string"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_run",
        "result"
      ],
      "properties": {
        "last_run": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "suite": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_review",
        "next_review"
      ],
      "properties": {
        "last_review": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "next_review": {
          "type": "string",
          "format": "date"
        },
        "governance_forum": {
          "type": "string",
          "description": "Where high risk agents are reviewed, for example an AI governance committee."
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason",
          "remediation",
          "expires",
          "approved_by"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "expires": {
            "type": "string",
            "format": "date"
          },
          "approved_by": {
            "type": "string"
          }
        }
      }
    },
    "cost_tags": {
      "type": "object",
      "description": "Mapping to the cloud tag taxonomy used for ownership and cost attribution.",
      "additionalProperties": false,
      "required": [
        "Application",
        "ApplicationOwner",
        "Environment",
        "CostCenter"
      ],
      "properties": {
        "Application": {
          "type": "string"
        },
        "ApplicationOwner": {
          "type": "string"
        },
        "Environment": {
          "type": "string"
        },
        "CostCenter": {
          "type": "string"
        },
        "Model": {
          "type": "string"
        },
        "Project": {
          "type": "string"
        },
        "ClientEngagement": {
          "type": "string"
        }
      }
    },
    "registered_on": {
      "type": "string",
      "format": "date"
    },
    "platform_ref": {
      "type": "string",
      "description": "The platform's own identifier for the agent (AgentCore runtime ARN, Copilot Studio bot ID, Agentforce API name). Used to reconcile discovered agents against the registry."
    },
    "risk_factors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_scope",
        "customer_impact"
      ],
      "description": "Inputs to the computed risk tier, together with autonomy_level and data_classification. See docs/adr/0005-behavioral-contract.md.",
      "properties": {
        "action_scope": {
          "enum": [
            "read_only",
            "write_internal",
            "write_external",
            "financial_binding"
          ],
          "description": "The most consequential thing the agent can do with its granted permissions. write_external means customers or third parties see the change. financial_binding means it moves money, changes a policy or beneficiary, or commits the firm."
        },
        "customer_impact": {
          "enum": [
            "internal_only",
            "customer_facing",
            "decides_on_customers"
          ],
          "description": "decides_on_customers means the output drives an eligibility, pricing, claims or servicing decision about a customer."
        }
      }
    },
    "behavioral_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted_intents",
        "constraints",
        "contract_scan",
        "runtime_guardrail",
        "tool_vetting"
      ],
      "description": "What the agent is for and what it must never do, after the AI Registry in Uber's Secure AI design. Access control says who may act; the contract says whether a proposed action is in scope.",
      "properties": {
        "persona": {
          "type": "string"
        },
        "permitted_intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          },
          "description": "Tasks the agent may perform, in business terms."
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "description": "Hard limits that hold even where access would allow the action."
        },
        "calls_agents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^agt-[a-z0-9-]{3,48}$"
          },
          "description": "Registry IDs of agents this agent delegates to."
        },
        "contract_scan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "last_run"
          ],
          "description": "Latest comparison of declared intents against what code, prompts, configuration and tool paths show the agent can do.",
          "properties": {
            "result": {
              "enum": [
                "match",
                "drift",
                "not_run"
              ]
            },
            "last_run": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "undeclared_capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "runtime_guardrail": {
          "enum": [
            "none",
            "shadow",
            "enforcing"
          ],
          "description": "shadow logs guardrail verdicts without blocking; enforcing blocks actions outside the intents and constraints."
        },
        "tool_vetting": {
          "enum": [
            "not_vetted",
            "findings_open",
            "vetted"
          ],
          "description": "Tools and MCP servers checked for poisoning and injection in their descriptions before connection."
        },
        "last_red_team": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "platform": {
            "enum": [
              "agentforce",
              "vendor-saas"
            ]
          }
        }
      },
      "then": {
        "required": [
          "vendor"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "risk_tier": {
            "const": "high"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "required": [
              "governance_forum"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "required": [
          "risk_factors"
        ]
      }
    }
  ],
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "email"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        }
      }
    }
  }
}
